name=\"locale_id\"\n                  value=\"uk\"\n                  type=\"submit\"\n                  class=\"dropdown__link\"\n>\n            \u0443\u043a\u0440\u0430\u0457\u043d\u0441\u044c\u043a\u0430\n          </button>\n        </li>\n        <li>\n          <button name=\"locale_id\"\n                  value=\"he\"\n                  type=\"submit\"\n                  class=\"dropdown__link\"\n>\n            \u05e2\u05d1\u05e8\u05d9\u05ea\n          </button>\n        </li>\n        <li>\n          <button name=\"locale_id\"\n                  value=\"zh_Hans\"\n                  type=\"submit\"\n                  class=\"dropdown__link\"\n>\n            \u4e2d\u6587 (\u7b80\u4f53)\n          </button>\n        </li>\n        <li>\n          <button name=\"locale_id\"\n                  value=\"zh_Hant\"\n                  type=\"submit\"\n                  class=\"dropdown__link\"\n>\n            \u4e2d\u6587 (\u7e41\u9ad4)\n          </button>\n        </li>\n        <li>\n          <button name=\"locale_id\"\n                  value=\"ja\"\n                  type=\"submit\"\n                  class=\"dropdown__link\"\n>\n            \u65e5\u672c\u8a9e\n          </button>\n        </li>\n        <li>\n          <button name=\"locale_id\"\n                  value=\"ko\"\n                  type=\"submit\"\n                  class=\"dropdown__link\"\n>\n            \ud55c\uad6d\uc5b4\n          </button>\n        </li>\n    </ul>\n  </form>\n</nav>  </div>\n</div>  </div>\n</div>\n</header>\n<main id=\"content\">\n  <div class=\"banner\">\n    <div class=\"homepage-banner\">\n      <h1 class=\"homepage-banner__title\">Find, install and publish Python packages with the Python Package Index</h1>\n      <form class=\"search-form search-form--large search-form--fullwidth\"\n            action=\"/search/\"\n            role=\"search\">\n        <label for=\"search\" class=\"sr-only\">Search PyPI</label>\n        <!-- The following input is intentionally not autofocused, see https://github.com/pypi/warehouse/issues/6088 for more details -->\n        <input id=\"search\"\n               class=\"search-form__search large-input\"\n               type=\"text\"\n               name=\"q\"\n               placeholder=\"Type '/' to search projects\"\n               autocomplete=\"off\"\n               autocapitalize=\"off\"\n               spellcheck=\"false\"\n               data-controller=\"search-focus\"\n               data-action=\"keydown@window->search-focus#focusSearchField\"\n               data-search-focus-target=\"searchField\">\n        <button type=\"submit\" class=\"search-form__button\">\n          <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\n          <span class=\"sr-only\">Search</span>\n        </button>\n      </form>\n      <p class=\"homepage-banner__browse\">\nOr <a href=\"/search/\">browse projects</a>      </p>\n      <p class=\"homepage-banner__browse\">\nPublishing as a team? Use an <a href=\"/organizations/\">organization account</a>      </p>\n    </div>\n  </div>\n  <div class=\"horizontal-section horizontal-section--grey horizontal-section--thin horizontal-section--statistics\">\n    <div class=\"statistics-bar\">\n      <p class=\"statistics-bar__statistic\">\n933,644 projects    </p>\n    <p class=\"statistics-bar__statistic\">\n10,094,390 releases  </p>\n  <p class=\"statistics-bar__statistic\">\n22,623,169 files</p>\n<p class=\"statistics-bar__statistic\">\n1,137,778 users</p>\n</div>\n</div>\n<div class=\"horizontal-section\">\n  <div class=\"about-pypi\">\n    <div class=\"about-pypi__logo\">\n      <img alt=\"\"\n           src=\"/static/images/logo-large.516e776d.svg\"\n           loading=\"lazy\">\n    </div>\n    <div class=\"about-pypi__text\">\n      <p class=\"lede-paragraph\">\nThe Python Package Index (PyPI) is a repository of software for the Python programming language.      </p>\n      <p>\nPyPI helps you find and install software developed and shared by the Python community.        <a href=\"https://packaging.python.org/tutorials/installing-packages/\"\n           title=\"External link\"\n           target=\"_blank\"\n           rel=\"noopener\">Learn about installing packages</a>.\n      </p>\n      <p>\nPackage authors use PyPI to distribute their software.        <a href=\"https://packaging.python.org/tutorials/packaging-projects/\"\n           title=\"External link\"\n           target=\"_blank\"\n           rel=\"noopener\">Learn how to package your Python code for PyPI</a>.\n      </p>\n    </div>\n  </div>\n</div>\n</main>\n<footer class=\"footer\">\n  <div class=\"footer__inner\">\n    <div class=\"footer__left\">\n      <a class=\"footer__logo\" href=\"/\">\n        <img src=\"/static/images/white-cube.2351a86c.svg\"\n             alt=\"\"\n             class=\"-js-white-cube\">\n        <span>PyPI</span>\n      </a>\n      <p class=\"footer__tagline\">Developed and maintained by the <a href=\"https://www.python.org/psf/\" title=\"External link\" target=\"_blank\" rel=\"noopener\">Python Software Foundation</a> and Python community, for the Python community.</p>\n        <p class=\"footer__status\">\n          <span class=\"footer__status-dot\" aria-hidden=\"true\"></span>\n          <a href=\"https://status.python.org/\"\n             title=\"External link\"\n             target=\"_blank\"\n             rel=\"noopener\">Status: <span data-statuspage-domain=\"https://2p66nmmycsj3.statuspage.io\">all systems operational</span></a>\n        </p>\n      <div class=\"footer__donate\">\n        <a class=\"button button--small\" href=\"https://donate.pypi.org\">Donate today!</a>\n      </div>\n    </div>\n    <div class=\"footer__right\">\n      <div class=\"footer__menu\">\n        <h2>Help</h2>\n        <nav aria-label=\"Help navigation\">\n          <ul>\n            <li>\n              <a href=\"https://docs.pypi.org/\">PyPI documentation</a>\n            </li>\n            <li>\n              <a href=\"https://docs.pypi.org/about/getting-help/\">Getting help</a>\n            </li>\n            <li>\n              <a href=\"https://packaging.python.org/tutorials/installing-packages/\"\n                 title=\"External link\"\n                 target=\"_blank\"\n                 rel=\"noopener\">Installing packages</a>\n            </li>\n            <li>\n              <a href=\"https://packaging.python.org/tutorials/packaging-projects/\"\n                 title=\"External link\"\n                 target=\"_blank\"\n                 rel=\"noopener\">Uploading packages</a>\n            </li>\n            <li>\n              <a href=\"https://packaging.python.org/\"\n                 title=\"External link\"\n                 target=\"_blank\"\n                 rel=\"noopener\">Packaging user guide</a>\n            </li>\n          </ul>\n        </nav>\n      </div>\n      <div class=\"footer__menu\">\n        <h2>About PyPI</h2>\n        <nav aria-label=\"About PyPI navigation\">\n          <ul>\n            <li>\n              <a href=\"https://blog.pypi.org\">PyPI blog</a>\n            </li>\n            <li>\n              <a href=\"https://dtdg.co/pypi\"\n                 title=\"External link\"\n                 target=\"_blank\"\n                 rel=\"noopener\">Infrastructure dashboard</a>\n            </li>\n            <li>\n              <a href=\"/stats/\">Statistics</a>\n            </li>\n            <li>\n              <a href=\"/trademarks/\">Logos & trademarks</a>\n            </li>\n            <li>\n              <a href=\"/sponsors/\">Our sponsors</a>\n            </li>\n          </ul>\n        </nav>\n      </div>\n      <div class=\"footer__menu\">\n        <h2>Contributing to PyPI</h2>\n        <nav aria-label=\"How to contribute navigation\">\n          <ul>\n            <li>\n              <a href=\"https://docs.pypi.org/about/contributing/#reporting-bugs\">Bugs and feedback</a>\n            </li>\n            <li>\n              <a href=\"https://github.com/py