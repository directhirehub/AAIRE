ss=\"site-menu__link\">Docs</a>\n        </li>\n        <li class=\"site-menu__item\">\n          <a href=\"/account/login/?next=https%3A%2F%2Fpypi.org%2F\" class=\"site-menu__link\">Log in</a>\n        </li>\n        <li class=\"site-menu__item\">\n          <a href=\"/account/register/\"\n             class=\"site-menu__link\">Register</a>\n        </li>\n      </ul>\n    </nav>\n    <nav class=\"dropdown dropdown--on-menu site-menu--dropdown site-menu--dropdown-below-desktop\"\n         aria-label=\"Main navigation\">\n      <button type=\"button\"\n              class=\"site-menu__link dropdown__trigger\"\n              aria-haspopup=\"true\"\n              aria-expanded=\"false\"\n              aria-label=\"View menu\">\n        <i class=\"fa-solid fa-bars\" aria-hidden=\"true\"></i>\n      </button>\n      <ul class=\"dropdown__content\"\n          aria-hidden=\"true\"\n          aria-label=\"Main menu\">\n        <li>\n          <a class=\"dropdown__link\" href=\"https://blog.pypi.org\">Blog</a>\n        </li>\n        <li>\n          <a class=\"dropdown__link\" href=\"https://docs.pypi.org/\">Docs</a>\n        </li>\n        <li>\n          <a class=\"dropdown__link\" href=\"/account/login/?next=https%3A%2F%2Fpypi.org%2F\">Log in</a>\n        </li>\n        <li>\n          <a class=\"dropdown__link\"\n             href=\"/account/register/\">Register</a>\n        </li>\n      </ul>\n    </nav>\n<nav class=\"dropdown dropdown--on-menu dropdown--with-icons site-menu--dropdown\"\n     aria-label=\"Localization\">\n  <button type=\"button\"\n          class=\"site-menu__link site-menu__link--with-icon dropdown__trigger\"\n          aria-haspopup=\"true\"\n          aria-expanded=\"false\"\n          aria-label=\"Change language\">\n    <i class=\"fa-solid fa-language\" aria-hidden=\"true\"></i>\n  </button>\n  <form action=\"/locale/\">\n    <ul class=\"dropdown__content dropdown__content--languages\"\n        aria-hidden=\"true\"\n        aria-label=\"Languages